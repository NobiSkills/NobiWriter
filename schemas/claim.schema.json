{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "claim_text": {
      "type": "string",
      "minLength": 1
    },
    "claim_type": {
      "enum": [
        "historical",
        "capability",
        "performance",
        "comparative",
        "contractual",
        "perception"
      ]
    },
    "product": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "population": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_required": {
      "type": "string",
      "minLength": 1
    },
    "evidence_existing": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "scope": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "reference",
          "date",
          "scope"
        ]
      }
    },
    "status": {
      "enum": [
        "proposed",
        "needs_evidence",
        "conditionally_allowed",
        "allowed",
        "blocked",
        "needs_review"
      ]
    },
    "decision_ref": {
      "type": "string",
      "minLength": 1
    },
    "decision_owner": {
      "type": "string",
      "minLength": 1
    },
    "allowed_wording": {
      "type": "string",
      "minLength": 1
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "review_trigger": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "claim_text",
    "claim_type",
    "product",
    "scope",
    "evidence_required",
    "evidence_existing",
    "status",
    "exceptions"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "allowed",
              "conditionally_allowed"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "decision_ref",
          "decision_owner",
          "allowed_wording",
          "conditions",
          "review_trigger"
        ],
        "properties": {
          "evidence_existing": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
