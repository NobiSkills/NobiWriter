{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "product": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "verified_at": {
      "type": "string",
      "format": "date"
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "availability": {
      "enum": [
        "internal",
        "pilot",
        "available",
        "suspended",
        "retired"
      ]
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "value": {},
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "key",
          "value",
          "conditions",
          "source_ref"
        ]
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "review_trigger": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "product",
    "version",
    "verified_at",
    "source_ref",
    "availability",
    "channels",
    "facts",
    "limitations",
    "risks",
    "review_trigger"
  ]
}
